# Banco de dados (Postgres — Neon)
DB_HOST=seu-endpoint.neon.tech
DB_PORT=5432
DB_NAME=conforto_habitat
DB_USER=conforto_habitat_app
DB_PASSWORD=

# CORS / cookies — domínio exato de cada front-end (sem *), separados por
# vírgula se houver mais de um (o admin e o participante são apps distintos)
FRONTEND_ORIGIN=https://admin.conforto-habitat.com.br,https://treinamento.conforto-habitat.com.br

# URL do front-end admin — usada só para montar o link clicável dos e-mails
# transacionais (convite de admin, redefinir senha). Diferente do
# FRONTEND_ORIGIN acima (que é a lista de CORS, pode ter mais de um domínio
# e não serve pra montar link).
ADMIN_FRONTEND_URL=https://admin.conforto-habitat.com.br

# E-mail transacional — hoje sem provedor real configurado (sem AWS SES);
# o link de convite/reset só é impresso no log do servidor (ver lib/email.js).
EMAIL_REMETENTE=acesso@conforto-habitat.com.br

# Porta em que o servidor Express escuta localmente (não é usada no Vercel,
# que gerencia a função serverless sozinho — ver api/index.js)
PORT=3000

# Nunca commitar este arquivo preenchido — usar as variáveis de ambiente
# do próprio provedor (painel do Vercel, Secrets Manager, etc).
