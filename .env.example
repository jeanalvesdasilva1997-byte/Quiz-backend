# Banco de dados (Postgres — Neon)
DB_HOST=seu-endpoint.neon.tech
DB_PORT=5432
DB_NAME=conforto_habitat
DB_USER=conforto_habitat_app
DB_PASSWORD=

# CORS / cookies — domínio exato de cada front-end (sem *), separados por
# vírgula se houver mais de um (o admin e o participante são apps distintos)
FRONTEND_ORIGIN=https://admin.conforto-habitat.com.br,https://treinamento.conforto-habitat.com.br

# URL do front-end admin — usada só para montar o link clicável dos e-mails
# transacionais (convite de admin, redefinir senha). Diferente do
# FRONTEND_ORIGIN acima (que é a lista de CORS, pode ter mais de um domínio
# e não serve pra montar link).
ADMIN_FRONTEND_URL=https://admin.conforto-habitat.com.br

# URL do front-end participante — usada pra montar o link enviado por
# e-mail quando uma turma é ativada ou alguém é cadastrado no dia. Sem
# essa variável, o e-mail simplesmente não é enviado (fica só um aviso
# no log — ver handlers/turmas.js e participantesAdmin.js).
PARTICIPANT_FRONTEND_URL=https://treinamento.conforto-habitat.com.br

# E-mail transacional via Resend (resend.com) — EMAIL_REMETENTE precisa ser
# de um domínio verificado na conta Resend, senão o envio falha (fica só
# logado, não derruba o fluxo — ver lib/email.js). Sem RESEND_API_KEY
# definida, o link de convite/reset só é impresso no log do servidor.
# EMAIL_REPLY_TO é a caixa real pra onde respostas do destinatário vão —
# separada do remetente "não-responda", padrão recomendado pelo Resend.
RESEND_API_KEY=
EMAIL_REMETENTE_NOME=Nera
EMAIL_REMETENTE=nao-responda@mail.neracompany.com.br
EMAIL_REPLY_TO=contato@neracompany.com.br

# Porta em que o servidor Express escuta localmente (não é usada no Vercel,
# que gerencia a função serverless sozinho — ver api/index.js)
PORT=3000

# Nunca commitar este arquivo preenchido — usar as variáveis de ambiente
# do próprio provedor (painel do Vercel, Secrets Manager, etc).
