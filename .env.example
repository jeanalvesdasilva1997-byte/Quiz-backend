# Banco de dados (Amazon RDS)
DB_HOST=seu-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=conforto_habitat
DB_USER=conforto_habitat_app
DB_PASSWORD=

# CORS / cookies — precisa ser o domínio exato dos front-ends (sem *)
FRONTEND_ORIGIN=https://treinamento.conforto-habitat.com.br

# E-mail transacional
EMAIL_REMETENTE=acesso@conforto-habitat.com.br

# Região AWS
AWS_REGION=sa-east-1

# Porta em que o servidor Express escuta (o Nginx faz proxy reverso para ela)
PORT=3000

# Nunca commitar este arquivo preenchido — usar Secrets Manager/SSM em produção.
